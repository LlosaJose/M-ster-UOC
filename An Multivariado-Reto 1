#2.b.Calcula estadísticos descriptivos para el conjunto completo y por Species.

summary(iris_data) #conjunto completo, estadística descriptiva


#Se hacen dos listas de vars a explorar por especies
#Se procede de este modo para que las tablas sean de menor tamaño
vars <- c("SepalLengthCm", "PetalLengthCm") 
vars2<- c("SepalWidthCm", "PetalWidthCm")

#Descriptivos de las variables Length
iris_data |> 
  group_by(Species) |>
  summarise(across(c(vars),
                   list(Media = mean, DT = sd)), n=n())

#Descriptivos de las variables Width
iris_data |> 
  group_by(Species) |>
  summarise(across(c(vars2),
                   list(Media = mean, DT = sd)), n=n())

